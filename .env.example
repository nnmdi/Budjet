# Development defaults to http://localhost:3000 and ./data.
# Production requires an HTTPS origin and a persistent private volume.
APP_URL=http://localhost:3000
PORT=3000
DATA_DIR=./data

# Optional, exact frontend origins for a separately hosted API (comma separated).
CORS_ORIGINS=
# Set true only for HTTPS cross-site frontend/API deployments.
COOKIE_CROSS_SITE=false
# Set to 1 only behind exactly one trusted reverse proxy.
TRUST_PROXY=0

# GitHub Pages: leave empty for browser-only local profiles.
# An HTTPS backend enables real server accounts instead.
VITE_API_BASE_URL=
