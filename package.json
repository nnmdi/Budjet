{
  "name": "cash-diet",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=build/server.cjs && esbuild scripts/backup.ts scripts/preflight.ts --bundle --platform=node --format=cjs --packages=external --outdir=build --out-extension:.js=.cjs",
    "start": "node build/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist build",
    "lint": "tsc --noEmit",
    "build:pages": "vite build --mode pages",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "backup": "node build/backup.cjs",
    "check:production": "node build/preflight.cjs",
    "check:deployment": "node scripts/check-deployment.cjs",
    "smoke:auth": "node scripts/smoke-auth.cjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "happy-dom": "^21.0.3",
    "node-mocks-http": "^1.18.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
